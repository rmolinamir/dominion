{
  "name": "dominion",
  "private": true,
  "version": "0.0.0",
  "description": "Domain-first TypeScript definitions and execution adapters",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=10.12.4"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint --config tooling/oxlint.json --deny-warnings .",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --config tooling/oxfmt.json --ignore-path tooling/oxfmtignore .",
    "format:check": "oxfmt --config tooling/oxfmt.json --ignore-path tooling/oxfmtignore --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm pack:check",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "pack:check": "node scripts/check-packages.mjs",
    "example:gift-cards": "pnpm build && node examples/gift-cards.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "^4.0.0",
    "@atomly/dominion-core": "workspace:^",
    "@atomly/dominion-node": "workspace:^"
  }
}
